# Copy to .env and adjust as needed.

# Match these to your host user (`id -u` / `id -g`) so files created in
# ./workspace are owned by you on the host.
USER_UID=1000
USER_GID=1000

# Pin a Claude Code version, or keep "latest".
CLAUDE_CODE_VERSION=latest

# Optional: authenticate with an API key instead of an interactive login.
# ANTHROPIC_API_KEY=sk-ant-...
