# Copy to .devcontainer/.env (next to compose.yaml) and adjust as needed.

# Match these to your host user (`id -u` / `id -g`) so files created in
# ./workspace are owned by you on the host.
USER_UID=1000
USER_GID=1000

# Optional: authenticate with an API key instead of an interactive login.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: token for gh (GitHub CLI) instead of `gh auth login`.
# The AI tools in the container can use it too, so use a fine-grained token
# limited to the repositories and permissions you need (see README).
# GH_TOKEN=github_pat_...
