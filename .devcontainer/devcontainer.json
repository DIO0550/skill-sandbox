// VS Code の Dev Containers で開くための設定。
// 中身は compose.yaml の構成（sandbox + firewall + proxy）そのままで、
// 通信制限やコンテナの権限は `docker compose up` で起動したときと同じになる。
// 詳しくは README の「VS Code（Dev Containers）で開く」を参照。
{
  "name": "skill-sandbox",
  "dockerComposeFile": ["../compose.yaml", "compose.devcontainer.yaml"],
  "service": "sandbox",
  // firewall と proxy がないと sandbox は起動しない（depends_on）。明示しておく
  "runServices": ["sandbox", "firewall", "proxy"],
  // ウィンドウを閉じたら 3 つとも止める
  "shutdownAction": "stopCompose",
  "workspaceFolder": "/workspace",
  "remoteUser": "claude",

  // イメージはホスト側で docker compose のビルドとして作る（`.env` の設定もそのまま使われる）。
  // Dev Containers 自身にビルドさせない理由は compose.devcontainer.yaml を参照
  "initializeCommand": ["docker", "compose", "build"],

  // コンテナ内ユーザーの uid をホストに合わせ直す機能は使わない。
  // ホストのユーザーが root だと uid 0 に書き換えてしまい、非 root で動かす制限が外れるため。
  // uid / gid は `.env` の USER_UID / USER_GID で合わせる（docker compose と同じ）
  "updateRemoteUserUID": false,

  // features は使わない（外部から取得したスクリプトを root で実行することになるため）。
  // 必要なものは Dockerfile で入れる。

  "customizations": {
    "vscode": {
      "settings": {
        // ホストの認証情報をコンテナに渡さない。
        // 既定ではホストの Git 認証情報・.gitconfig・Docker の認証情報・GitHub CLI のトークンが
        // コンテナから使えるようになり、許可している github.com 経由でホストのアカウントの
        // リポジトリに書き込めてしまう。
        "dev.containers.copyGitConfig": false,
        "dev.containers.gitCredentialHelperConfigLocation": "none",
        "dev.containers.dockerCredentialHelper": false,
        "dev.containers.githubCLILoginWithToken": false
      }
    }
  }
}
